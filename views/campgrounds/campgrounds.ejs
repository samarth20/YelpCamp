<%- include ("../partials/header"); -%>

<div class="container">
    <header class="jumbotron">
        <div class="container">
            <h1>Welcome To YelpCamp!</h1>
            <p>View out hand-picked campgrounds from all over the world</p>
            <p>
                <a class="btn btn-primary btn-lg" href="/campgrounds/new">Add New CampGround</a>
            </p>    
        </div>
    </header>
    
    <div class="row text-center" style="display:flex; flex-wrap:wrap;">
        <% for(var x=0;x<campgrounds.length;x++){ %>
            <div class="col-md-3 col-sm-6">
                <div class="thumbnail">
                    <img src="<%= campgrounds[x].image %>">
                    <div class="caption">
                        <h4> <%= campgrounds[x].name %> </h4>
                    </div>
                    <p>
                        <a href="/campgrounds/<%= campgrounds[x].id %>" class="btn btn-primary">More Info</a>
                    </p>
                </div>
            </div>
        <% } %>
    </div>
</div>

<%- include("../partials/footer"); -%>